# Copy to .env (backend reads ../.env or backend/.env). Never commit real keys.

# Database: SQLite for development (default), PostgreSQL for production
# DATABASE_URL=sqlite:///./data/logmind.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/logmind
POSTGRES_PASSWORD=logmind

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_MB=50
RATE_LIMIT_PER_MINUTE=600

# Privacy: comma list of email,phone,token,password,apikey,ip,identifier or "none"
MASK_RULES=email,phone,token,password,apikey

# Sentence-Transformers (downloaded on first use; falls back to LSA, clearly labelled, if unavailable)
EMBEDDING_MODEL=all-MiniLM-L6-v2     # any Hugging Face sentence-embedding model id
HF_TOKEN=                            # Hugging Face access token (put it ONLY here, never in code or chat)
EMBEDDINGS_ENABLED=true

# Optional LLM rewrite of rule-based summaries. Leave empty to run fully offline / free.
LLM_PROVIDER=          # openai | gemini | huggingface (huggingface: LLM_API_KEY = your HF token, LLM_MODEL required)
LLM_API_KEY=
LLM_MODEL=

# Frontend (build time): URL of the backend API when not proxied
# VITE_API_URL=https://your-backend.example.com
